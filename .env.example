# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI API key (platform.openai.com -> API keys)
OPENAI_API_KEY=

# LLM settings
# One model for development, evals and demo (consistent behavior)
LLM_MODEL=gpt-6.2-sol
LLM_REASONING_EFFORT=medium

# Access code the chat UI must send (protects API credits on the public URL)
APP_ACCESS_CODE=change-me

# Token for admin endpoints (e.g. POST /api/admin/recompute)
ADMIN_TOKEN=change-me-too

# Where score-change alerts are POSTed (webhook.site URL or Slack incoming webhook). Optional.
ALERT_WEBHOOK_URL=

# SQLite database path (relative to repo root)
DB_PATH=data/risk.db
