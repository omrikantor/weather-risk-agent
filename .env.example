# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI API key (platform.openai.com -> API keys)
OPENAI_API_KEY=

# LLM settings
# One model for development, evals and demo (consistent behavior)
LLM_MODEL=gpt-6.2-sol
LLM_REASONING_EFFORT=medium

# Access code the chat UI must send (protects API credits on the public URL). Empty = open (local only).
APP_ACCESS_CODE=change-me

# Token for admin endpoints (raise the budget at runtime, recompute scores). Empty = admin disabled.
ADMIN_TOKEN=change-me-too

# Limits for /api/chat
CHAT_RATE_LIMIT_PER_MIN=10
DAILY_BUDGET_USD=3.0

# Extra allowed browser origins (comma-separated); empty = same origin only
CORS_ORIGINS=

# Live warning alerts: where each check posts new alerts (Slack incoming webhook or a webhook.site test URL).
# Optional; empty = alerts are recorded and shown at /api/alerts but not sent.
ALERT_WEBHOOK_URL=

# SQLite database path (relative to repo root)
DB_PATH=data/risk.db
